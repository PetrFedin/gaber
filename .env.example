# Скопируйте в .env (файл .env не коммитится). Значения ниже — только для локальной разработки.
GABER_PG_PASSWORD=change-me-local-dev
GABER_PG_PORT=55481
DATABASE_URL=postgres://gaber:change-me-local-dev@127.0.0.1:55481/gaber
PORT=8787
HOST=127.0.0.1
# Через запятую: источники, с которых разрешены POST/PUT/DELETE с cookie.
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
# Адрес API для Vite-прокси (только dev).
GABER_API_URL=http://127.0.0.1:8787
# Для интеграционных тестов: отдельная база (создаётся командой из docs/server.md).
TEST_DATABASE_URL=postgres://gaber:change-me-local-dev@127.0.0.1:55481/gaber_test
