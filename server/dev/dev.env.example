# Скопируйте в server/dev/dev.env (не коммитится). Значения только для локальной одноразовой базы.
GABER_DEV_PG_ADMIN_PASSWORD=change-me-admin-dev
GABER_DEV_PG_PORT=55482
GABER_DEV_DB_ORDERS_PASSWORD=change-me-orders-dev
GABER_DEV_DB_AUTH_PASSWORD=change-me-auth-dev
# Для server/index.js (после npm run dev:setup):
GABER_ORDERS_DATABASE_URL=postgres://gaber_app_orders:change-me-orders-dev@127.0.0.1:55482/gaber_dev
GABER_AUTH_DATABASE_URL=postgres://gaber_app_auth:change-me-auth-dev@127.0.0.1:55482/gaber_dev
GABER_TENANT_ID=TENANT-DEV
# Только разработка: считать MFA пройденным, иначе записи партнёра и фабрики отклоняются политикой.
GABER_DEV_ASSUME_MFA=1
# Для dev:setup (суперпользователь, только локально) и интеграционного теста:
GABER_DEV_ADMIN_DATABASE_URL=postgres://postgres:change-me-admin-dev@127.0.0.1:55482/gaber_dev
